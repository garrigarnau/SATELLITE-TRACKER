# Keeps the API keys server-side: the browser calls /api/*, nginx adds the key.
# Responses are cached (per endpoint, see below) so visitors share upstream calls
# and don't burn the N2YO hourly quotas.
proxy_cache_path /var/cache/nginx/api levels=1:2 keys_zone=api:10m max_size=200m inactive=2d;

server {
    listen 80;
    root /usr/share/nginx/html;

    # Orbital elements are refreshed a few times a day.
    location /api/n2yo/tle/ {
        rewrite ^/api/n2yo/(.*)$ /rest/v1/satellite/$1&apiKey=${N2YO_API_KEY} break;
        proxy_pass https://api.n2yo.com;
        proxy_set_header Host api.n2yo.com;
        proxy_ssl_server_name on;
        proxy_cache api;
        proxy_cache_valid 200 6h;
        proxy_cache_lock on;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        add_header X-Cache $upstream_cache_status;
    }

    # "above" is a live view of the sky; keep it fresh.
    location /api/n2yo/ {
        rewrite ^/api/n2yo/(.*)$ /rest/v1/satellite/$1&apiKey=${N2YO_API_KEY} break;
        proxy_pass https://api.n2yo.com;
        proxy_set_header Host api.n2yo.com;
        proxy_ssl_server_name on;
        proxy_cache api;
        proxy_cache_valid 200 1m;
        proxy_cache_lock on;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        add_header X-Cache $upstream_cache_status;
    }

    location /api/geocode {
        rewrite ^ /geocode/v1/json?key=${OPENCAGE_API_KEY} break;
        proxy_pass https://api.opencagedata.com;
        proxy_set_header Host api.opencagedata.com;
        proxy_ssl_server_name on;
        proxy_cache api;
        proxy_cache_valid 200 1d;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
    }

    # CelesTrak (no key). SATCAT changes daily, so cache it for a day.
    location = /api/celestrak/satcat/records.php {
        rewrite ^/api/celestrak/(.*)$ /$1 break;
        proxy_pass https://celestrak.org;
        proxy_set_header Host celestrak.org;
        proxy_ssl_server_name on;
        proxy_cache api;
        proxy_cache_valid 200 1d;
        proxy_cache_valid 404 1h;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_403 http_429 http_500 http_502 http_503;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        add_header X-Cache $upstream_cache_status;
    }

    # Orbital elements update every ~2 h. CelesTrak answers 403 to repeat
    # downloads within an update and firewalls clients that keep erroring, so
    # cache for 2 h and keep serving the stale copy if it refuses.
    location = /api/celestrak/NORAD/elements/gp.php {
        rewrite ^/api/celestrak/(.*)$ /$1 break;
        proxy_pass https://celestrak.org;
        proxy_set_header Host celestrak.org;
        proxy_ssl_server_name on;
        proxy_cache api;
        proxy_cache_valid 200 2h;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_403 http_429 http_500 http_502 http_503;
        proxy_cache_background_update on;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        add_header X-Cache $upstream_cache_status;
    }

    # The whole Starlink catalogue (OMM JSON, ~5 MB, ~600 KB gzipped) for the
    # /starlink page. One fixed cache key, so every visitor shares one upstream
    # download per 2 h update; the lock (with a timeout longer than the download)
    # keeps concurrent misses from each hitting CelesTrak, and stale copies are
    # served when it answers 403 ("not updated since your last download").
    location = /api/starlink {
        rewrite ^ /NORAD/elements/gp.php?GROUP=starlink&FORMAT=json break;
        proxy_pass https://celestrak.org;
        proxy_set_header Host celestrak.org;
        proxy_set_header Accept-Encoding "";
        proxy_ssl_server_name on;
        proxy_cache api;
        proxy_cache_key "celestrak-gp-starlink-json";
        proxy_cache_valid 200 2h;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 60s;
        proxy_cache_lock_age 60s;
        proxy_cache_use_stale error timeout updating http_403 http_429 http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_read_timeout 60s;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        proxy_hide_header Content-Disposition;
        gzip on;
        gzip_proxied any;
        gzip_types application/json;
        gzip_min_length 1024;
        add_header Cache-Control "public, max-age=1800";
        add_header X-Cache $upstream_cache_status;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        # Prerendered routes (scripts/prerender.mjs) live at /route/index.html.
        try_files $uri $uri/index.html /index.html;
    }
}
